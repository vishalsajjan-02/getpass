{
  "name": "gatepass-backend",
  "version": "1.0.0",
  "description": "Gatepass Nexus backend API",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx src/database/migrate.ts",
    "seed": "tsx src/database/seed.ts",
    "seed:attendance": "tsx src/database/seed-attendance.ts",
    "seed:leave-types": "tsx src/database/seed-leave-types.ts",
    "seed:company-holidays": "tsx src/database/seed-company-holidays.ts",
    "seed:gatepasses:100": "tsx src/database/seed-gatepass-bulk-100.ts",
    "seed:gatepasses:10": "tsx src/database/seed-gatepass-10-users.ts",
    "setup": "tsx src/database/migrate.ts && tsx src/database/seed.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "form-data": "^4.0.6",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pg": "^8.11.3",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/form-data": "^2.2.1",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^9.0.7",
    "tsx": "^4.7.0",
    "typescript": "^5.3.2"
  }
}
